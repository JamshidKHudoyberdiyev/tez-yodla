{
  "expo": {
    "name": "Tez Yodla",
    "slug": "tez-yodla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.tezyodla.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5A2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.tezyodla.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "yodla",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#12261A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#12261A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F5A2E",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "disableAutoUpload": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "backgroundColor": "#12261A"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0b7e664e-ba54-46bd-a55f-18f271724cdf"
      }
    },
    "owner": "jamshidxudoyberdiyev",
    "updates": {
      "url": "https://u.expo.dev/0b7e664e-ba54-46bd-a55f-18f271724cdf"
    }
  }
}
